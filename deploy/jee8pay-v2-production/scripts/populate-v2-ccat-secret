#!/usr/bin/env bash
set -euo pipefail

readonly target_dir=/opt/jee8pay-v2-production/secrets/ccat-provider

[[ $(id -u) -eq 0 ]] || { echo 'must run as root' >&2; exit 1; }
[[ -t 0 && -t 1 ]] || { echo 'interactive TTY required' >&2; exit 1; }

read -r -p 'Type PRODUCTION to confirm Provider environment: ' environment
[[ $environment == PRODUCTION ]] || { echo 'environment must be PRODUCTION' >&2; exit 1; }
read -r -s -p 'CCAT custId: ' cust_id
printf '\n'
read -r -s -p 'CCAT apiPassword: ' api_password
printf '\n'
[[ -n $cust_id && -n $api_password ]] || { echo 'values must not be empty' >&2; exit 1; }

install -d -o root -g root -m 0700 "$target_dir"
temporary_dir=$(mktemp -d /run/jee8pay-v2-production-ccat.XXXXXX)
trap 'rm -rf -- "$temporary_dir"' EXIT
umask 077
printf '%s' PRODUCTION >"$temporary_dir/environment"
printf '%s' "$cust_id" >"$temporary_dir/custId"
printf '%s' "$api_password" >"$temporary_dir/apiPassword"
unset cust_id api_password
install -o root -g root -m 0600 "$temporary_dir/environment" "$target_dir/environment"
install -o root -g root -m 0600 "$temporary_dir/custId" "$target_dir/custId"
install -o root -g root -m 0600 "$temporary_dir/apiPassword" "$target_dir/apiPassword"

echo 'PROD_V2_CCAT_SECRET_INTAKE=READY'

