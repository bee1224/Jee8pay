#!/usr/bin/env bash
set -euo pipefail

readonly secret_dir=/opt/jee8pay-v2-production/secrets

[[ $(id -u) -eq 0 ]] || { echo 'must run as root' >&2; exit 1; }
command -v openssl >/dev/null || { echo 'openssl is required' >&2; exit 1; }

install -d -o root -g root -m 0700 "$secret_dir"

create_secret() {
  local owner=$1
  local group=$2
  local target=$3
  [[ ! -e $target ]] || return 0
  local temporary
  temporary=$(mktemp "$secret_dir/.secret.XXXXXX")
  openssl rand -base64 48 | tr -d '\n' >"$temporary"
  chown "$owner:$group" "$temporary"
  chmod 0600 "$temporary"
  mv -- "$temporary" "$target"
}

create_secret root root "$secret_dir/db-root-password"
create_secret 10001 10001 "$secret_dir/db-app-password"
create_secret 10001 10001 "$secret_dir/manager-jwt-secret"
create_secret 10001 10001 "$secret_dir/merchant-jwt-secret"

echo 'V2_INFRASTRUCTURE_SECRETS=READY'

